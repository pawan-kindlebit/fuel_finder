<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- ══ HEADER with gradient ══════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛽"
                    android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FuelFinder"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real petrol pumps on your route"
                    android:textColor="#CCE0F2FF"
                    android:textSize="11sp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Reset"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:visibility="gone"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp"
                app:cornerRadius="17dp"/>
        </LinearLayout>

        <!-- FROM input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_dot_green"
                android:gravity="center">
                <View android:layout_width="8dp" android:layout_height="8dp"
                    android:background="@drawable/dot_white"/>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFrom"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Start location (e.g. Delhi)"
                android:textColorHint="#88AABBCC"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:inputType="textCapWords|textNoSuggestions"
                android:imeOptions="actionNext"
                android:singleLine="true"/>

            <ProgressBar
                android:id="@+id/pbFrom"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- FROM suggestions dropdown -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFromSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:background="@drawable/bg_suggestions_card"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:nestedScrollingEnabled="false"/>

        <!-- TO input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_dot_red"
                android:gravity="center">
                <View android:layout_width="8dp" android:layout_height="8dp"
                    android:background="@drawable/dot_white"/>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTo"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Destination (e.g. Chandigarh)"
                android:textColorHint="#88AABBCC"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:inputType="textCapWords|textNoSuggestions"
                android:imeOptions="actionSearch"
                android:singleLine="true"/>

            <ProgressBar
                android:id="@+id/pbTo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- TO suggestions dropdown -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvToSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:background="@drawable/bg_suggestions_card"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:nestedScrollingEnabled="false"/>

        <!-- Search button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Find Fuel Stations"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/btn_search"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/white"
            app:iconPadding="8dp"
            app:iconSize="18dp"/>

    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone"/>

    <!-- Loading status -->
    <TextView
        android:id="@+id/tvLoadingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone"/>

    <!-- Error -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/error_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚠️  " android:textSize="15sp"/>
        <TextView
            android:id="@+id/tvError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/error_text"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Full screen map + overlays -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_empty_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⛽" android:textSize="40sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Enter route above"
                android:textColor="@color/text_dark" android:textSize="15sp" android:textStyle="bold"
                android:gravity="center" android:layout_marginTop="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="to see real petrol pumps"
                android:textColor="@color/text_muted" android:textSize="12sp"
                android:gravity="center" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Route chip -->
        <LinearLayout
            android:id="@+id/layoutRouteChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="12dp"
            android:background="@drawable/bg_route_chip"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRouteFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:maxWidth="100dp"
                android:ellipsize="end"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ➜  "
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvRouteTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:maxWidth="100dp"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/tvRouteDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- FAB -->
        <LinearLayout
            android:id="@+id/btnShowList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_fab_fuel"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="8dp"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⛽" android:textSize="26sp"/>
            <TextView
                android:id="@+id/tvPumpCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
